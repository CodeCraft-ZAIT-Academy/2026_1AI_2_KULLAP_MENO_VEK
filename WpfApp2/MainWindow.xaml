<Window x:Class="WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Image HorizontalAlignment="Center" Height="434" VerticalAlignment="Center" Width="800" Stretch="Fill" Source="/pascal-debrunner-d7Bvh_2cFnA-unsplash.jpg" OpacityMask="Black"/>
        <Image HorizontalAlignment="Center" Height="602" VerticalAlignment="Center" Width="477" Source="/white-text-box-shape-removebg-preview.png" Stretch="Fill" Opacity="0.9"/>
        <Label x:Name="Meno" Content="Meno a Priezvisko:" HorizontalAlignment="Left" Margin="213,129,0,0" VerticalAlignment="Top" Height="33" Width="187" FontFamily="Ink Free" FontSize="20" FontWeight="Bold"/>
        <TextBox x:Name="menobox" HorizontalAlignment="Left" Height="33" Margin="400,129,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="160" FontFamily="Yu Gothic Medium" FontSize="18" BorderThickness="3,3,3,3" BorderBrush="#FF93A4D4" Background="White"/>
        <Label x:Name="Datum_Narodenia" Content="Datum Narodenia:" HorizontalAlignment="Left" Margin="213,172,0,0" VerticalAlignment="Top" Height="33" Width="187" FontFamily="Ink Free" FontWeight="Bold" FontSize="20"/>
        <DatePicker x:Name="datebox" HorizontalAlignment="Left" Margin="400,172,0,0" VerticalAlignment="Top" Width="160" Height="33" BorderThickness="3,3,3,3" BorderBrush="#FF93A4D4" FontFamily="Yu Gothic Medium" FontSize="16" FontWeight="Bold" CalendarClosed="Button_Click"/>
        <Button Content="Pozdrav" HorizontalAlignment="Center" Margin="0,246,0,0" VerticalAlignment="Top" Height="42" Width="108" FontFamily="Segoe UI Black" Background="#FF2373F4" RenderTransformOrigin="0.5,0.5" AutomationProperties.IsColumnHeader="True" Foreground="White" Click="Button_Click"/>

    </Grid>
</Window>
